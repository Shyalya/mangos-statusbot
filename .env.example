# Discord
DISCORD_TOKEN=
STATUS_CHANNEL_ID=
CHAT_CHANNEL_ID=

# MySQL
DB_HOST=127.0.0.1
DB_USER=mangos
DB_PASSWORD=
DB_CHARACTERS=characters
DB_LOGON=realmd

# Realm and world server, for the TCP reachability check
REALMD_HOST=127.0.0.1
REALMD_PORT=3724
WORLD_HOST=127.0.0.1
WORLD_PORT=8085

# Path to the core's chat.log
CHAT_LOG_PATH=/pfad/zum/server/build/src/logs/chat.log
CHAT_POLL_MS=1000

# Internal port of the bridge (bound to 127.0.0.1 only)
BRIDGE_PORT=3001

# Character that Discord messages are spoken through in game.
# Excluded from the player count and the player list.
BRIDGE_CHARACTER=Discord

# Class icons as JSON, emoji ids from your own Discord server.
# Leave empty for names without icons.
# CLASS_ICONS={"WARRIOR":"<:warrior:000000000000000000>"}
