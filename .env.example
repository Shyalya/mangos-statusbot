# Discord
DISCORD_TOKEN=
STATUS_CHANNEL_ID=
CHAT_CHANNEL_ID=

# MySQL
DB_HOST=127.0.0.1
DB_USER=mangos
DB_PASSWORD=
DB_CHARACTERS=characters
DB_LOGON=realmd

# Realm- und Weltserver, fuer den TCP-Erreichbarkeitstest
REALMD_HOST=127.0.0.1
REALMD_PORT=3724
WORLD_HOST=127.0.0.1
WORLD_PORT=8085

# Pfad zur chat.log des Kerns
CHAT_LOG_PATH=/pfad/zum/server/build/src/logs/chat.log
CHAT_POLL_MS=1000

# Interner Port der Bruecke (nur auf 127.0.0.1 gebunden)
BRIDGE_PORT=3001

# Charakter, ueber den Discord-Nachrichten im Spiel gesprochen werden.
# Wird aus Spielerzaehlung und -liste herausgerechnet.
BRIDGE_CHARACTER=Discord

# Klassensymbole als JSON, Emoji-IDs aus dem eigenen Discord.
# Leer lassen = Namen ohne Symbol.
